#!/bin/bash -xe
exec > /var/log/user-data.log 2>&1

JOB_ID="${job_id}"
T_VAL="${t_val}"
BUCKET="${S3_BUCKET}"
PREFIX="jobs/${job_id}"

USR="ubuntu"
id ubuntu >/dev/null 2>&1 || USR="ec2-user"

sudo mkdir -p /home/$USR/jacob/output /home/$USR/jacob/logs || true
sudo chown -R $USR:$USR /home/$USR || true

cd /home/$USR/jacob || exit 1

set +e
sudo -u $USR /home/$USR/jacob/bin/z z_distributed_precalc "$T_VAL" "$JOB_ID" \
  >&1 | tee -a /home/$USR/jacob/output/precalc_run.log
RC=${PIPESTATUS[0]}
set -e

# Adjust this path if your app writes elsewhere
PRECALC_FILE="/home/$USR/jacob/output/pre_calc.txt"

if [ -f "$PRECALC_FILE" ]; then
  /usr/local/bin/aws s3 cp "$PRECALC_FILE" "s3://$BUCKET/$PREFIX/pre_calc.txt" --only-show-errors || true
fi

/usr/local/bin/aws s3 cp /home/$USR/jacob/output/precalc_run.log "s3://$BUCKET/$PREFIX/precalc_run.log" --only-show-errors || true

if [ "$RC" -eq 0 ]; then
  echo "PRECALC_DONE" | tee -a /home/$USR/jacob/output/precalc_run.log
else
  echo "PRECALC_FAILED (rc=$RC)" | tee -a /home/$USR/jacob/output/precalc_run.log
fi

sudo shutdown -h now