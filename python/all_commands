#!/bin/bash -xe
exec > /var/log/user-data.log 2>&1

# ---- launch-time variables (filled by Lambda via Template.safe_substitute) ----
JOB_ID="${job_id}"
T_VAL="${t_val}"
TOTAL_ZEROS="${zeros_val}"
BUCKET="${S3_BUCKET}"
PREFIX="jobs/${job_id}"

# ---- detect default user (Ubuntu vs Amazon Linux) ----
USR="ubuntu"
id ubuntu >/dev/null 2>&1 || USR="ec2-user"

# ---- workspace (user-owned) ----
sudo mkdir -p /home/$USR/jacob/output /home/$USR/jacob/logs || true
sudo chown -R $USR:$USR /home/$USR || true

###############################################################################
# /etc/z-job.env (consumed by timers/scripts)  [root-owned]
###############################################################################
sudo bash -c 'cat >/etc/z-job.env <<'"'EOFENV'"'
BUCKET=${S3_BUCKET}
PREFIX=jobs/${job_id}
USR=__USR__
JOB_ID=${job_id}
TOTAL_ZEROS=${zeros_val}
# Use a single file name; switch to a glob later if needed
ZEROS_CSV=/home/__USR__/jacob/output/valley_walk.csv
JSON_OUT=/home/__USR__/jacob/progress.json
EOFENV'
# inject resolved USR into template
sudo sed -i "s/__USR__/$USR/g" /etc/z-job.env
sudo chmod 0644 /etc/z-job.env

###############################################################################
# /usr/local/bin/zeros_to_json.py (preserve ALL decimals as strings) [root]
###############################################################################
sudo install -m 0755 -o root -g root /dev/null /usr/local/bin/zeros_to_json.py
sudo bash -c 'cat >/usr/local/bin/zeros_to_json.py <<'"'PYEOF'"'
#!/usr/bin/env python3
import argparse, csv, json, os, sys, tempfile

def read_csv_safely_as_strings(path: str):
    if not os.path.exists(path):
        return []
    with open(path, "rb") as f:
        data = f.read()
    text = data.decode("utf-8", errors="replace")
    lines = text.splitlines(keepends=True)
    # keep only complete lines to avoid reading a half-written tail
    complete_lines = [ln for ln in lines if ln.endswith("\n") or ln.endswith("\r\n")]
    if not complete_lines:
        return []
    joined = "".join(complete_lines)
    rdr = csv.reader(joined.splitlines())
    rows = list(rdr)
    if not rows:
        return []
    header = [h.strip().lower() for h in rows[0]]
    start_idx = 1 if len(header) >= 3 and header[0] == "t" and header[1] in ("absz","|z|") and header[2] == "n" else 0
    out = []
    for r in rows[start_idx:]:
        if len(r) < 3:
            continue
        t_str, absz_str, n_str = r[0].strip(), r[1].strip(), r[2].strip()
        if not t_str or not absz_str or not n_str:
            continue
        out.append([t_str, absz_str, n_str])  # KEEP AS STRINGS (full precision)
    return out

def write_json_atomically(obj, out_path: str):
    d = os.path.dirname(os.path.abspath(out_path)) or "."
    os.makedirs(d, exist_ok=True)
    with tempfile.NamedTemporaryFile("w", dir=d, delete=False) as tmp:
        tmp_path = tmp.name
        json.dump(obj, tmp, ensure_ascii=False, separators=(",", ":"), indent=2)
        tmp.flush()
        os.fsync(tmp.fileno())
    os.replace(tmp_path, out_path)

def main():
    ap = argparse.ArgumentParser(description="zeros.csv -> JSON (preserve decimals as strings)")
    ap.add_argument("--zeros-csv", required=True)
    ap.add_argument("--out", required=True)
    ap.add_argument("--total", type=int, required=True)
    ap.add_argument("--job-id", required=True)
    args = ap.parse_args()

    zeros = read_csv_safely_as_strings(args.zeros_csv)
    processed = len(zeros)
    payload = {
        "jobId": args.job_id,
        "processed": f"{processed}/{args.total}",
        "zeros": zeros
    }
    write_json_atomically(payload, args.out)

if __name__ == "__main__":
    try:
        main()
    except Exception as e:
        print(f"zeros_to_json error: {e}", file=sys.stderr)
        sys.exit(0)
PYEOF'
sudo chmod +x /usr/local/bin/zeros_to_json.py

###############################################################################
# /usr/local/bin/ship_to_s3.sh  [root]
###############################################################################
sudo install -m 0755 -o root -g root /dev/null /usr/local/bin/ship_to_s3.sh
sudo bash -c 'cat >/usr/local/bin/ship_to_s3.sh <<'"'SHEOF'"'
#!/usr/bin/env bash
set -Eeuo pipefail
source /etc/z-job.env

# prevent overlap if upload takes longer than the cadence
exec 9>/var/lock/ship_to_s3.lock
flock -n 9 || exit 0

LOG_FILE="/var/log/user-data.log"
OUT_DIR="/home/${USR}/jacob/output"
LOG_DIR="/home/${USR}/jacob/logs"
PROGRESS_JSON="/home/${USR}/jacob/progress.json"
S3_BASE="s3://${BUCKET}/${PREFIX}"

# use absolute path for aws in case PATH differs under systemd
AWSBIN="/usr/bin/aws"
command -v $AWSBIN >/dev/null 2>&1 || AWSBIN="aws"

$AWSBIN s3 cp "${LOG_FILE}" "${S3_BASE}/user-data.log" --only-show-errors || true
if [ -d "${OUT_DIR}" ]; then
  $AWSBIN s3 cp --recursive "${OUT_DIR}" "${S3_BASE}/output/" --only-show-errors || true
fi
if [ -d "${LOG_DIR}" ]; then
  $AWSBIN s3 cp --recursive "${LOG_DIR}" "${S3_BASE}/logs/" --only-show-errors || true
fi
if [ -f "${PROGRESS_JSON}" ]; then
  $AWSBIN s3 cp "${PROGRESS_JSON}" "${S3_BASE}/progress.json" --only-show-errors || true
fi
SHEOF'
sudo chmod +x /usr/local/bin/ship_to_s3.sh

###############################################################################
# systemd: zeros-to-json (every 10s)  [root]
###############################################################################
sudo bash -c 'cat >/etc/systemd/system/zeros-to-json.service <<'"'USVC'"'
[Unit]
Description=Convert zeros.csv to JSON for FE
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/z-job.env
ExecStart=/usr/bin/python3 /usr/local/bin/zeros_to_json.py \
  --zeros-csv ${ZEROS_CSV} \
  --out ${JSON_OUT} \
  --total ${TOTAL_ZEROS} \
  --job-id ${JOB_ID}
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
USVC'

sudo bash -c 'cat >/etc/systemd/system/zeros-to-json.timer <<'"'UTMR'"'
[Unit]
Description=Run zeros-to-json every 10 seconds

[Timer]
OnBootSec=30s
OnUnitActiveSec=10s
AccuracySec=1s
Unit=zeros-to-json.service

[Install]
WantedBy=timers.target
UTMR'

###############################################################################
# systemd: ship-to-s3 (every 10s)  [root]
###############################################################################
sudo bash -c 'cat >/etc/systemd/system/ship-to-s3.service <<'"'SSVC'"'
[Unit]
Description=Ship Z batch artifacts to S3

[Service]
Type=oneshot
EnvironmentFile=/etc/z-job.env
ExecStart=/usr/local/bin/ship_to_s3.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
SSVC'

sudo bash -c 'cat >/etc/systemd/system/ship-to-s3.timer <<'"'STMR'"'
[Unit]
Description=Run ship-to-s3 every 10 seconds

[Timer]
OnBootSec=30s
OnUnitActiveSec=10s
AccuracySec=1s
Unit=ship-to-s3.service

[Install]
WantedBy=timers.target
STMR'

# ---- activate timers ----
sudo systemctl daemon-reload
sudo systemctl enable --now zeros-to-json.timer ship-to-s3.timer
sudo systemctl status zeros-to-json.timer --no-pager || true
sudo systemctl status ship-to-s3.timer   --no-pager || true

###############################################################################
# run the app (as $USR); continues producing valley_walk.csv
###############################################################################
cd /home/$USR/jacob || exit 1
set +e
sudo -u $USR /home/$USR/jacob/bin/z valley_walk "$T_VAL" "$TOTAL_ZEROS" "$JOB_ID" >&1 | tee -a /home/$USR/jacob/output/run.log
RC=${PIPESTATUS[0]}
set -e

# optional plotting, best-effort
latest=$(find output -maxdepth 1 -type f -name '*walk_plot*.csv' -printf '%T@ %p\n' 2>/dev/null | sort -nr | head -n1 | cut -d' ' -f2-)
[ -n "$latest" ] && python3 plotting_mountains.py "$latest" || echo "No CSVs in output/"

# final S3 markers + copy (shipper timer is also running)
if [ "$RC" -eq 0 ]; then
  echo "JOB_DONE"  | tee -a /home/$USR/jacob/output/run.log
else
  echo "JOB_FAILED (rc=$RC)" | tee -a /home/$USR/jacob/output/run.log
fi

# explicit final copy
/usr/bin/aws s3 cp /home/$USR/jacob/output/run.log "s3://$BUCKET/$PREFIX/run.log" --only-show-errors || true
[ -d /home/$USR/jacob/output ] && aws s3 cp --recursive /home/$USR/jacob/output s3://$BUCKET/$PREFIX/output/ || true
[ -d /home/$USR/jacob/logs   ] && aws s3 cp --recursive /home/$USR/jacob/logs   s3://$BUCKET/$PREFIX/logs/   || true

# halt (instance profile is set to terminate on shutdown)
sudo shutdown -h now
